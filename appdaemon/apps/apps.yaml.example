# AppDaemon Apps Configuration
# Battery Optimizer - Nord Pool price-based charge/discharge scheduling

battery_optimizer:
  module: battery_optimizer
  class: BatteryOptimizer

  # ==========================================================================
  # Home Assistant Connection (required for built-in Nord Pool integration)
  # ==========================================================================

  # Your Home Assistant URL (internal)
  ha_url: "http://homeassistant.local:8123"

  # Long-lived access token from HA
  # Create at: Profile (bottom left) > Security > Long-Lived Access Tokens > Create Token
  ha_token: "REPLACE_WITH_YOUR_HA_LONG_LIVED_TOKEN"

  # ==========================================================================
  # Nord Pool Configuration
  # ==========================================================================

  # Config entry ID from diagnostics file
  # Find it in: Settings > Devices > Nord Pool > 3-dot menu > Download diagnostics
  nordpool_config_entry: "YOUR_NORDPOOL_CONFIG_ENTRY_ID"
  nordpool_area: LV

  # Hour when tomorrow's prices become available (in YOUR local timezone)
  # Nord Pool publishes at 13:00 CET. Convert to your timezone:
  # - CET (Germany, France, etc.): 13
  # - EET (Latvia, Lithuania, Estonia, Finland): 14
  # - UK/Ireland: 12
  tomorrow_prices_hour: 14

  # For HACS custom component (not needed if using built-in):
  # nordpool_sensor: sensor.nordpool_kwh_lv_eur_3_10

  # Growatt battery state of charge sensor
  soc_sensor: sensor.growatt_battery_battery_soc

  # Growatt PV power production sensor (for solar-aware adjustments)
  # NOTE: total PV power; renamed by integration v0.6.7 device-prefix migration
  # (previously the non-existent sensor.growatt_pv_power)
  pv_power_sensor: sensor.growatt_solar_solar_total_power

  # Growatt battery temperature sensor (for temperature-aware charge rate prediction)
  # When configured, the optimizer learns and predicts charge rates based on temperature
  # This improves scheduling accuracy for batteries that charge slower when cold
  # Leave empty to disable temperature-aware learning
  battery_temp_sensor: "sensor.growatt_battery_battery_temperature"

  # --------------------------------------------------------------------------
  # Ambient temperature (thermal model)
  # --------------------------------------------------------------------------
  # The battery temperature forecast relaxes toward AMBIENT. Without an external
  # source, ambient is guessed as min(recent battery temperatures) — in summer
  # that is ~the current battery temperature, which makes the whole 33 h
  # temperature forecast practically constant.
  #
  # Preferred: a real sensor in the room where the battery lives.
  # outdoor_temp_sensor: sensor.garage_temperature
  #
  # Alternative: a HA weather entity with an hourly forecast (outdoor air).
  # ambient_weather_entity: weather.forecast_home
  #
  # Fallback profile (used when neither of the above is set, and to extend a
  # single sensor reading across the horizon). With no external source the
  # rolling battery minimum anchors the profile's daily MAXIMUM — the pack is
  # self-heated, so it never sits below ambient and its minimum is a ceiling on
  # ambient, not the trough of the daily swing:
  # ambient_diurnal_amplitude_c: 4.0   # half of the peak-to-peak daily swing
  # ambient_diurnal_peak_hour: 15.0    # local hour of the daily maximum
  # ambient_forecast_cache_minutes: 60
  #
  # Thermal model fallbacks, used until ~20 raw thermal samples are collected:
  # thermal_default_cooling_rate_per_min: 0.012   # k1, Newtonian relaxation
  # thermal_default_heating_c_per_kwh: 0.35       # k2, self-heating per kWh

  # Inverter energy sensors for precise energy measurement (0.1 kWh precision)
  # These cumulative daily sensors provide more accurate tracking than SOC-based calculation
  # Set use_inverter_energy_sensors to false to fall back to SOC-based calculation
  battery_charge_sensor: "sensor.growatt_battery_battery_charge_today"
  battery_discharge_sensor: "sensor.growatt_battery_battery_discharge_today"
  use_inverter_energy_sensors: true

  # ==========================================================================
  # Device Control
  # ==========================================================================

  # Growatt WIT device ID for Modbus control
  # Find this in Home Assistant Developer Tools > States > growatt entities
  device_id: "YOUR_GROWATT_WIT_DEVICE_ID"  # <-- Set your device_id here

  # ==========================================================================
  # Battery Parameters
  # ==========================================================================

  # Total battery capacity in kWh
  battery_capacity_kwh: 14.3

  # Charge rate in kW (use conservative average for planning)
  # Actual may vary 3-6 kW, use 4.5 for reliable scheduling
  charge_rate_kw: 4.5

  # Discharge rate in kW
  discharge_rate_kw: 5.9

  # Minimum state of charge (emergency reserve)
  min_soc: 10

  # Maximum state of charge (full charge allowed)
  max_soc: 100

  # Battery/storage charge-retention factor. This is NOT complete round-trip
  # efficiency: inverter_efficiency is also applied on AC->DC and DC->AC paths.
  # With 0.95 and inverter_efficiency 0.97, implied grid AC round trip is ~89.4%.
  efficiency: 0.95

  # Base house consumption in Watts
  # This is the minimum load when nothing else is running
  base_consumption_w: 500

  # Household load power sensor (W) used for statistical load profiling
  # Prefer a sensor representing net house load (consumption minus PV)
  # Leave empty to disable probabilistic load profiling
  load_power_sensor: "sensor.growatt_load_house_consumption"

  # Schedule resolution in minutes (15 = quarter-hourly plan)
  slot_minutes: 15

  # Recalculate schedule every N minutes (independent of slot_minutes)
  adaptive_recalc_minutes: 15

  # Load observation interval (minutes)
  load_observation_minutes: 15

  # Quantile for load forecast (0.5 = median, 0.8 = conservative)
  load_quantile: 0.75

  # DP SOC resolution in percent (smaller = more precise, slower)
  soc_step_percent: 0.25

  # Load profile persistence
  # File path preferred (unlimited size). Leave empty to disable file persistence.
  load_profile_file: "/config/load_profile.json"
  # Learning data persistence (JSON file on disk)
  learning_data_file: "/config/battery_learning_data.json"
  # Optional HA input_text mirror (keep empty to avoid 255-char limit)
  load_profile_entity: ""
  load_profile_max_samples: 60
  load_profile_min_samples: 6

  # Status sensors (optional)
  load_profile_last_observation_entity: sensor.load_profile_last_observation
  load_profile_observation_count_entity: sensor.load_profile_observation_count

  # If load sensor reports 0W under its minimum threshold, use last non-zero
  # reading and never go below this floor value.
  load_zero_floor_w: 450

  # ==========================================================================
  # Pricing Parameters
  # ==========================================================================

  # Fixed grid fees per kWh added to spot price when buying
  # Trading margin (0.01238) + distribution fee (0.03962) = 0.052
  grid_fee_eur_kwh: 0.052

  # Applied to (spot + grid_fee). Keep 1.0 when those inputs already include
  # the desired VAT basis; use 1.21 only when both are VAT-exclusive and 21%
  # VAT applies. Never apply VAT twice.
  import_price_multiplier: 1.0

  # Fixed fee subtracted from spot price when selling (net metering deduction)
  # Sell price = max(0, nordpool - 0.02)
  grid_export_fee_eur_kwh: 0.02

  # Export rate multiplier (1.0 = no percentage reduction, deduction is fixed via grid_export_fee)
  export_rate_multiplier: 1.0

  # Inverter AC↔DC conversion efficiency (Growatt WIT European weighted: 97%)
  # Applied to grid charge cost (AC→DC) and battery discharge value (DC→AC)
  inverter_efficiency: 0.97

  # Battery wear cost per kWh (discourages cycling at marginal prices)
  # Growatt HOPE 14.3L-A1: 3811.50 EUR (ar PVN, pēc atlaides) - 2287.47 EUR (valsts atbalsts 38.12%) = 1524.03 EUR
  # 1524.03 / (8000 cycles × 14.3 kWh × 0.80 DOD) = 0.017
  battery_wear_cost_eur_kwh: 0.017

  # Value of one usable DC kWh left at the end of the known price horizon.
  # "auto" derives a conservative value from horizon prices, discharge conversion,
  # and wear.
  #
  # 0 is "no-salvage" mode: it declares stored energy worthless at the horizon,
  # so every plan ends by spending it — the log shows the last slots as
  # "EXPORT (until depleted) -> <min_soc>%". That is harmless while the daily
  # re-optimization extends the horizon before those slots execute.
  #
  # Neither setting is universally correct, so the app only STATES which mode is
  # active (INFO at startup and in the DP log) and never nags:
  #   0      -> risks spending the battery at the horizon edge
  #   "auto" -> risks stranding charge there and skipping evening slots priced
  #             below the median forecast import price
  # Pick per installation and record why, next to the value.
  terminal_energy_value_eur_kwh: "auto"

  # IMPORTANT: the import/export values above are examples. Verify trading
  # margins, distribution charges, deductions, and VAT basis for your contract.

  # ==========================================================================
  # Optimization Thresholds
  # ==========================================================================

  # PV power threshold for solar override (Watts)
  # When PV exceeds this, pause grid charging to use solar
  pv_threshold_w: 500

  # PV forecast (Solcast HACS integration)
  solcast_today_entity: sensor.solcast_pv_forecast_forecast_today
  solcast_tomorrow_entity: sensor.solcast_pv_forecast_forecast_tomorrow

  # --- Reactive PV shortfall detection ---
  # A shortfall is measured on COMPLETED slots using the average of
  # pv_sample_seconds samples (slot energy), never a single instantaneous read.
  pv_reactive_threshold: 0.5          # recalc when measured/forecast < this
  pv_reactive_min_forecast_w: 200     # ignore slots forecast below this
  # The streak is reset once a recalculation fires, so persistent cloud cover
  # costs at most one recalculation per pv_reactive_consecutive_slots slots.
  pv_reactive_consecutive_slots: 2    # required consecutive shortfall slots
  pv_reactive_min_samples: 3          # min samples per slot to trust the mean
  pv_sample_seconds: 60               # PV power sampling interval

  # --- Sliding PV forecast bias ---
  # Median actual/forecast ratio over the last pv_bias_window_minutes, clamped
  # and applied to the CURRENT AND REMAINING horizon (not just one slot).
  # Relaxes back to 1.0 over pv_bias_decay_slots when no fresh data arrives.
  pv_bias_enabled: true
  pv_bias_window_minutes: 120
  pv_bias_min_slots: 2
  pv_bias_min_factor: 0.2
  pv_bias_max_factor: 1.5
  pv_bias_decay_slots: 8
  # Beyond the current local day the factor is attenuated toward 1.0: today's
  # cloud cover is weather, not a calibration error of tomorrow's forecast.
  # Each further day keeps weight**days of the deviation, floored separately.
  # Set weight to 1.0 and the floor to 0.0 for the old whole-horizon behaviour.
  pv_bias_next_day_weight: 0.5
  pv_bias_next_day_min_factor: 0.7

  # SOC deviation threshold for schedule recalculation (%)
  # If actual SOC differs from expected by more than this, recalculate
  soc_deviation_threshold: 4

  # Decision transparency logging (0=minimal, 1=summary, 2=verbose, 3=max decision details)
  # Level 1: Log charge calculation breakdown and recalculation triggers
  # Level 2: Also log candidate charge slots, arbitrage analysis
  decision_log_level: 1

  # ==========================================================================
  # Inverter Control Timing / Blocking
  # ==========================================================================
  # set_wit_mode is a SYNCHRONOUS service call on the AppDaemon callback thread:
  # every second of this timeout blocks every other callback of this app. A
  # client-side timeout is NOT a lost command — verify-after-set covers it — so
  # a short window is the safe choice. Also give AppDaemon more than one thread
  # (appdaemon.yaml -> appdaemon: total_threads: 4).
  set_wit_mode_timeout_seconds: 15

  # Verify-after-set. The integration recomputes its Inverter Mode sensor on
  # each coordinator poll (~30-60s), so the sensor LAGS a write. If the log
  # shows many "mode mismatch ... resending once" lines that all recover on the
  # re-check (sensor.battery_inverter_control_health -> resend_recovered_count),
  # raise verify_delay_seconds rather than chasing the inverter.
  verify_delay_seconds: 90       # first check after a mode is sent
  verify_recheck_seconds: 60     # the single re-check after a resend

  # Warn when one of this app's callbacks blocks the thread for longer than this
  # (AppDaemon's own "Excessive time spent in callback" limit is 10s).
  callback_warn_seconds: 10

  # ==========================================================================
  # Home Assistant Control Entities
  # ==========================================================================

  # Input boolean to enable/disable the optimizer
  enabled_entity: input_boolean.battery_optimizer_enabled

  # Input boolean for manual override mode
  override_entity: input_boolean.battery_optimizer_override

  # Input select for manual mode selection
  manual_mode_entity: input_select.battery_manual_mode
